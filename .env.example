# Local Gemini proxy for Google Form AutoFiller (P12A)
# Copy to .env.local (preferred) or .env and fill in values.
# Never commit .env, .env.local, or real API keys.

# Required. Read only by the local backend — never by the extension.
GEMINI_API_KEY=

# Gemini model id for the Interactions API
GEMINI_MODEL=gemini-2.5-flash

# Per-request timeout for Gemini calls (milliseconds)
GEMINI_TIMEOUT_MS=15000

# Bind address for the local backend (keep loopback for safety)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8787
