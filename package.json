{
  "name": "google-form-auto-filler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension foundation for filling Google Forms with a saved profile, matching, and optional AI answers.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "p2-discovery-smoke": "tsx --tsconfig tsconfig.app.json scripts/p2-discovery-smoke.ts",
    "p3-classification-smoke": "tsx --tsconfig tsconfig.app.json scripts/p3-classification-smoke.ts",
    "p4-extraction-smoke": "tsx --tsconfig tsconfig.app.json scripts/p4-extraction-smoke.ts",
    "p5-fill-smoke": "tsx --tsconfig tsconfig.app.json scripts/p5-fill-smoke.ts",
    "p6-navigation-smoke": "tsx --tsconfig tsconfig.app.json scripts/p6-navigation-smoke.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.304",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "linkedom": "^0.18.13",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
